{
  "manifest_version": 3,
  "name": "Riah YouTube Quality",
  "version": "0.1.1",
  "description": "Sets YouTube playback quality up to your preferred ceiling.",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Riah YouTube Quality",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "main-world.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "homepage_url": "https://riahstudio.com/"
}
