{
  "manifest_version": 3,
  "name": "Riah YouTube Resume",
  "version": "0.1.1",
  "description": "Puts you back where you were in a YouTube video after the tab is discarded or reopened.",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Riah YouTube Resume",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "homepage_url": "https://riahstudio.com/"
}
