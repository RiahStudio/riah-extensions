{
  "manifest_version": 3,
  "name": "Riah Timeline Exporter",
  "version": "0.1.0",
  "description": "Exports visible X/Twitter posts to a local CSV file.",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Riah Timeline Exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "timeline-exporter@riah.extensions",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "homepage_url": "https://riahstudio.com/"
}
