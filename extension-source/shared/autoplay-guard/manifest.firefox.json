{
  "manifest_version": 3,
  "name": "Riah Autoplay Guard",
  "version": "0.2.7",
  "description": "Blocks unwanted media autoplay outside music sites without pausing media you started.",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Riah Autoplay Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "quiet-hosts/index.js",
        "main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "exclude_matches": [
        "*://whatsapp.com/*",
        "*://*.whatsapp.com/*",
        "*://whatsapp.net/*",
        "*://*.whatsapp.net/*",
