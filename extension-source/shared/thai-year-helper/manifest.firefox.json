{
  "manifest_version": 3,
  "name": "Riah Thai Year Helper",
  "version": "0.1.0",
  "description": "Adds Gregorian year context beside Buddhist Era years on supported pages.",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Riah Thai Year Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.co.th/*",
        "https://google.co.th/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "thai-year-helper@riah.extensions",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "homepage_url": "https://riahstudio.com/"
}
